<Window
    x:Class="timActionCenter.AddTileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="Add tile"
    Width="460"
    Height="640"
    ui:WindowHelper.UseModernWindowStyle="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock
                    Margin="0,0,0,18"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Add a new tile" />

                <TextBlock Margin="0,0,0,5" Text="Title" />
                <TextBox
                    x:Name="TitleTextBox"
                    Margin="0,0,0,12"
                    MaxLength="40" />

                <TextBlock Margin="0,0,0,5" Text="Description" />
                <TextBox
                    x:Name="DescriptionTextBox"
                    Height="54"
                    Margin="0,0,0,12"
                    AcceptsReturn="True"
                    MaxLength="160"
                    TextWrapping="Wrap" />

                <TextBlock Margin="0,0,0,5" Text="Icon" />
                <ComboBox
                    x:Name="IconComboBox"
                    Margin="0,0,0,12"
                    ItemsSource="{Binding IconOptions}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="32"
                                    FontFamily="{Binding FontFamily}"
                                    FontSize="18"
                                    Text="{Binding Glyph}" />
                                <TextBlock Text="{Binding Code}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Margin="0,0,0,5" Text="Behavior" />
                <ComboBox
                    x:Name="BehaviorComboBox"
                    Margin="0,0,0,12"
                    ItemsSource="{Binding Behaviors}"
                    SelectionChanged="OnBehaviorChanged" />

                <StackPanel x:Name="ActionPanel">
                    <TextBlock Margin="0,0,0,5" Text="Command or file path" />
                    <TextBox
                        x:Name="CommandTextBox"
                        Margin="0,0,0,12"
                        ToolTip="Example: notepad.exe" />

                    <TextBlock Margin="0,0,0,5" Text="Arguments (optional)" />
                    <TextBox
                        x:Name="ArgumentsTextBox"
                        Margin="0,0,0,12" />

                    <TextBlock Margin="0,0,0,5" Text="Working directory (optional)" />
                    <TextBox
                        x:Name="WorkingDirectoryTextBox"
                        Margin="0,0,0,8" />

                    <CheckBox
                        x:Name="WaitForExitCheckBox"
                        Margin="0,0,0,6"
                        Content="Wait for the command to finish" />
                    <CheckBox
                        x:Name="RunHiddenCheckBox"
                        Margin="0,0,0,12"
                        Content="Run without showing a window" />
                </StackPanel>

                <StackPanel x:Name="TogglePanel" Visibility="Collapsed">
                    <TextBlock
                        Margin="0,0,0,12"
                        Opacity="0.7"
                        Text="The state command must exit with code 0 when the tile is active."
                        TextWrapping="Wrap" />
                    <CheckBox
                        x:Name="RunToggleHiddenCheckBox"
                        Margin="0,0,0,12"
                        Content="Run enable and disable commands without showing a window"
                        IsChecked="True" />

                    <TextBlock FontWeight="SemiBold" Text="State command" />
                    <TextBox
                        x:Name="StateCommandTextBox"
                        Margin="0,5,0,5" />
                    <TextBox
                        x:Name="StateArgumentsTextBox"
                        Margin="0,0,0,14"
                        ToolTip="State command arguments" />

                    <TextBlock FontWeight="SemiBold" Text="Enable command" />
                    <TextBox
                        x:Name="EnableCommandTextBox"
                        Margin="0,5,0,5" />
                    <TextBox
                        x:Name="EnableArgumentsTextBox"
                        Margin="0,0,0,14"
                        ToolTip="Enable command arguments" />

                    <TextBlock FontWeight="SemiBold" Text="Disable command" />
                    <TextBox
                        x:Name="DisableCommandTextBox"
                        Margin="0,5,0,5" />
                    <TextBox
                        x:Name="DisableArgumentsTextBox"
                        Margin="0,0,0,12"
                        ToolTip="Disable command arguments" />
                </StackPanel>

                <TextBlock
                    Opacity="0.7"
                    Text="Supports environment variables and {AppDirectory}, {LocalAppData}, and {AppData}."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="86"
                Margin="0,0,8,0"
                Content="Cancel"
                IsCancel="True" />
            <Button
                MinWidth="86"
                Click="OnAddClick"
                Content="Add"
                IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
