<Window
    x:Class="timActionCenter.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="clr-namespace:timActionCenter.Presentation"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="Settings"
    Width="620"
    Height="520"
    ui:WindowHelper.UseModernWindowStyle="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="18">
                    <CheckBox
                        x:Name="StartWithWindowsCheckBox"
                        Margin="0,0,0,16"
                        Content="Start timActionCenter when I sign in to Windows" />
                    <CheckBox
                        x:Name="HideOnDeactivationCheckBox"
                        Margin="0,0,0,16"
                        Content="Hide the tile canvas when it loses focus" />
                    <CheckBox
                        x:Name="KeepWindowOnTopCheckBox"
                        Margin="0,0,0,16"
                        Content="Keep the tile canvas above other windows" />
                    <CheckBox
                        x:Name="ConfirmDeletionCheckBox"
                        Margin="0,0,0,16"
                        Content="Ask before deleting a tile" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Opacity="0.7"
                        Text="Settings and tile configuration are stored in your local application-data folder."
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Tiles">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="4,0,4,10"
                        Opacity="0.7"
                        Text="Hide tiles without deleting their configuration, reorder them, or delete them permanently."
                        TextWrapping="Wrap" />

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Tiles}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{x:Static presentation:SegoeFluentIconProvider.FontFamily}"
                                        FontSize="22"
                                        Text="{Binding IconGlyph}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Opacity="0.65"
                                            Text="{Binding Behavior}" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="2"
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        Content="Show"
                                        IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="3"
                                        MinWidth="34"
                                        Margin="3,0"
                                        AutomationProperties.Name="Move tile up"
                                        Click="OnMoveUpClick"
                                        Content="&#xE70E;"
                                        FontFamily="{x:Static presentation:SegoeFluentIconProvider.FontFamily}"
                                        ToolTip="Move up" />
                                    <Button
                                        Grid.Column="4"
                                        MinWidth="34"
                                        Margin="3,0"
                                        AutomationProperties.Name="Move tile down"
                                        Click="OnMoveDownClick"
                                        Content="&#xE70D;"
                                        FontFamily="{x:Static presentation:SegoeFluentIconProvider.FontFamily}"
                                        ToolTip="Move down" />
                                    <Button
                                        Grid.Column="5"
                                        MinWidth="34"
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="Delete tile"
                                        Click="OnDeleteClick"
                                        Content="&#xE74D;"
                                        FontFamily="{x:Static presentation:SegoeFluentIconProvider.FontFamily}"
                                        ToolTip="Delete" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel
            Grid.Row="1"
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="86"
                Margin="0,0,8,0"
                Content="Cancel"
                IsCancel="True" />
            <Button
                MinWidth="86"
                Click="OnSaveClick"
                Content="Save"
                IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
